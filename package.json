{
  "name": "elewa",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Elewa — helping Somali/Oromo-speaking Kenyan parents understand CBC homework and talk to their child's teacher",
  "scripts": {
    "dev": "concurrently -n server,client -c green,yellow \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --watch server/index.js",
    "dev:client": "vite",
    "start": "npm run dev",
    "smoke": "node scripts/smoke.mjs",
    "build": "vite build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.68.0",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "multer": "^2.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "vite": "^5.4.11"
  }
}
